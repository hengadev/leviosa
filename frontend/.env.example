# =============================================================================
# SvelteKit Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values for your environment
# (`make local-dev` does this automatically on first run).
#
# Environment Variables Usage:
# - Static private ($env/static/private): Variables known at build time
# - Dynamic private ($env/dynamic/private): Variables resolved at runtime
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Node environment (development, staging, production)
# - development: Local development environment
# - staging: Testing environment
# - production: Live production environment
NODE_ENV="development"

# Enable mock authentication mode (requires login with mock credentials below)
# - true: Auth is required but uses mock credentials instead of the real backend
# - false: Use real authentication via the local backend (make local-dev)
# Leave false for real local development — flip to true only to demo the UI standalone.
USE_MOCK_DATA="false"

# Mock credentials (only required when USE_MOCK_DATA=true)
# Each pair maps to a role — visitors must log in with one of these to access the app
# MOCK_ADMIN_EMAIL="admin@demo.leviosa.fr"
# MOCK_ADMIN_PASSWORD="demo-admin"
# MOCK_PARTNER_EMAIL="partner@demo.leviosa.fr"
# MOCK_PARTNER_PASSWORD="demo-partner"
# MOCK_CLIENT_EMAIL="client@demo.leviosa.fr"
# MOCK_CLIENT_PASSWORD="demo-client"

# Coming soon mode — redirects all routes to /coming-soon when set to "true"
# Set to "true" on production until the app is ready to launch
# Set to "false" (or omit) on staging to allow normal development
COMING_SOON="false"

# Backend API base URL
# - Development (make local-dev): the backend container publishes 127.0.0.1:3500
# - Production: Use your actual backend API domain
API_URL="http://localhost:3500"

# -----------------------------------------------------------------------------
# Session Management
# -----------------------------------------------------------------------------

# Name of the session cookie stored in the user's browser
# Used for authentication and session persistence
SESSION_COOKIE_NAME="leviosa_session"

# -----------------------------------------------------------------------------
# HTTP Headers
# -----------------------------------------------------------------------------

# Header name used to pass the client's IP address through the proxy/reverse proxy
# Common values: X-Forwarded-For, X-Real-IP, CF-Connecting-IP (header names are
# case-insensitive). x-client-ip matches what the backend expects behind Caddy
# and what backend/compose.yaml sets in local dev.
CLIENT_IP_HEADER="x-client-ip"

# -----------------------------------------------------------------------------
# Analytics (self-hosted, cookieless — Plausible)
# -----------------------------------------------------------------------------
# Wired into public routes only — see src/routes/(public)/+layout.svelte.
# Client/staff/admin dashboards never load this script. Leave both unset
# (the default) to disable tracking entirely, e.g. in local dev or in any
# environment without an approved, deployed Plausible instance
# (docs/issues/008-cookieless-analytics.md is HITL — infra ships opt-in).
#
# PUBLIC_PLAUSIBLE_DOMAIN — the "site" identifier registered in Plausible,
# normally the apex domain regardless of which host served the page:
# PUBLIC_PLAUSIBLE_DOMAIN="leviosa.care"
#
# PUBLIC_PLAUSIBLE_SRC — the tracking script URL, served by the self-hosted
# Plausible instance (see infra/ansible/roles/analytics):
# PUBLIC_PLAUSIBLE_SRC="https://analytics.leviosa.care/js/script.js"
