# Copy to .env and fill in. Used by `make local-start` / `make local-stop` (local.compose.yaml)
# to run the whole app (frontend, backend, Postgres, Redis, RabbitMQ, S3 and KMS via LocalStack)
# in containers, close to how it runs in production.
#
# Everything below has a working default baked into local.compose.yaml — you only need to
# set values here to override them (e.g. to test real Stripe/Twilio/SMTP integrations locally).

APP_ENV=local
PORT=3000
BACKEND_PORT=3500
COMING_SOON=false
USE_MOCK_DATA=false

# Session (shared between frontend and backend so cookies match)
SESSION_COOKIE_NAME=leviosa_session
CLIENT_IP_HEADER=x-client-ip
SESSION_SECRET=local-dev-session-secret-change-me
BOOKING_TOKEN_SECRET=local-dev-booking-token-secret

# Postgres
POSTGRES_DB=leviosa
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Redis
REDIS_PASSWORD=secret
REDIS_DB=0

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# encx pepper (base64 of 32 bytes). This dev value is public; the KEK is a LocalStack KMS key
# that local.compose.yaml creates on startup.
ENCX_PEPPER=bGV2aW9zYS1sb2NhbC1kZXYtcGVwcGVyLTMyYnl0ZXM=

# S3 (served by LocalStack locally — see S3_ENDPOINT in local.compose.yaml's backend service)
S3_BUCKET_NAME=leviosa

# First superadmin, created by the `admin` one-off (./leviosa bootstrap-admin) on every
# local-start when the account doesn't exist yet. Only that one-off container receives
# these values — never the running backend or frontend — and bootstrap-admin never
# modifies an account that already exists. These are public local values, not secrets.
ADMIN_EMAIL=admin@local.leviosa.test
ADMIN_PASSWORD=Local-Admin-1234
ADMIN_FIRST_NAME=Local
ADMIN_LAST_NAME=Admin
ADMIN_TELEPHONE=+33600000000
ADMIN_POSTAL_CODE=75001
ADMIN_CITY=Paris
ADMIN_ADDRESS1=1 Rue Locale
ADMIN_ADDRESS2=

# Stripe (optional — leave blank to skip payment features locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Twilio (optional — leave blank to skip SMS features locally)
# Authenticates with an API key (SID + secret) on the account, never the
# account's auth token. An API key only works in the region it was created in.
# Region/edge empty = Twilio's default (US1); deployed environments use
# TWILIO_REGION=ie1 and TWILIO_EDGE=dublin. The sender is an alphanumeric
# sender ID (e.g. Leviosa) or an E.164 number (e.g. +33...).
# Prove the values end to end, in the backend container: ./leviosa check-sms <to>
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_REGION=
TWILIO_EDGE=
TWILIO_SENDER=

# SMTP (optional — leave blank to skip email features locally)
# Prove the values end to end, in the backend container: ./leviosa check-email <to>
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
