# Copy to development.env and fill in (make local-dev does this for you automatically).
# Everything required to boot the backend already has a working default in compose.yaml —
# these are only the optional third-party integrations.

# Stripe (optional — leave blank to skip payment features locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Twilio (optional — leave blank to skip SMS features locally)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP (optional — leave blank to skip email features locally)
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First superadmin — read by the `bootstrap-admin` run mode
# (go run ./cmd/app bootstrap-admin), which each deploy runs once as a
# one-off after migrations. It creates the account only if no user with
# ADMIN_EMAIL exists and never modifies an existing one.
#
# Outside development (ENVIRONMENT != development) every value except
# ADMIN_ADDRESS2 is required, and ADMIN_PASSWORD must be at least 12
# characters containing a lowercase letter, an uppercase letter and a digit;
# anything else makes the run exit non-zero. These non-secret defaults exist
# only for local development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1234!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_TELEPHONE=+33600000000
ADMIN_POSTAL_CODE=75001
ADMIN_CITY=Paris
ADMIN_ADDRESS1=1 Rue Example
ADMIN_ADDRESS2=
