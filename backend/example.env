# Copy to development.env and fill in (make local-dev does this for you automatically).
# Everything required to boot the backend already has a working default in compose.yaml —
# these are only the optional third-party integrations.

# Stripe (optional — leave blank to skip payment features locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Twilio (optional — leave blank to skip SMS features locally)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP (optional — leave blank to skip email features locally)
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
