# Copy to development.env and fill in (make local-dev does this for you automatically).
# Infrastructure wiring (database, Redis, RabbitMQ, S3) has working defaults in compose.yaml.
# The encryption block below is required and works as is; the rest are optional
# third-party integrations. Nothing in this file is a secret.

# Encryption (encx, ADR-0015). The KEK is a KMS key in LocalStack, created behind this alias
# by compose.yaml's localstack-init; deployed environments use a real AWS KMS key. The value
# must be an alias name ("alias/<name>"), never a key ID or ARN.
ENCX_KMS_KEY_ALIAS=alias/leviosa-dev
# Base64 of exactly 32 bytes. This dev pepper is public; each deployed environment has its
# own in Infisical. The backend refuses to start if it is missing or the wrong length.
ENCX_PEPPER=bGV2aW9zYS1sb2NhbC1kZXYtcGVwcGVyLTMyYnl0ZXM=
# encx's in-memory cache of decrypted data keys (issue 031): repeated reads of the
# same record within the TTL make no KMS call. Leave both unset for the defaults
# (4096 entries, 10 minutes); set ENCX_DEK_CACHE_MAX_ENTRIES=0 to disable the cache.
# ENCX_DEK_CACHE_MAX_ENTRIES=4096
# ENCX_DEK_CACHE_TTL=10m
# LocalStack accepts any credentials. AWS_ENDPOINT_URL is for LocalStack only (compose.yaml
# replaces it with the in-network address); leave it unset against real AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:24566

# Stripe (optional — leave blank to skip payment features locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Twilio (optional — leave blank to skip SMS features locally)
# Authenticates with an API key (SID + secret) on the account, never the
# account's auth token. An API key only works in the region it was created in.
# Region/edge empty = Twilio's default (US1); deployed environments use
# TWILIO_REGION=ie1 and TWILIO_EDGE=dublin. The sender is an alphanumeric
# sender ID (e.g. Leviosa) or an E.164 number (e.g. +33...).
# Prove the values end to end with: go run ./cmd/app check-sms <to>
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_REGION=
TWILIO_EDGE=
TWILIO_SENDER=

# SMTP (optional — leave blank to skip email features locally)
# Prove the values end to end with: go run ./cmd/app check-email <to>
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# First superadmin — read by the `bootstrap-admin` run mode
# (go run ./cmd/app bootstrap-admin), which each deploy runs once as a
# one-off after migrations. It creates the account only if no user with
# ADMIN_EMAIL exists and never modifies an existing one.
#
# Outside development (ENVIRONMENT != development) every value except
# ADMIN_ADDRESS2 is required, and ADMIN_PASSWORD must be at least 12
# characters containing a lowercase letter, an uppercase letter and a digit;
# anything else makes the run exit non-zero. These non-secret defaults exist
# only for local development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe1234!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_TELEPHONE=+33600000000
ADMIN_POSTAL_CODE=75001
ADMIN_CITY=Paris
ADMIN_ADDRESS1=1 Rue Example
ADMIN_ADDRESS2=
