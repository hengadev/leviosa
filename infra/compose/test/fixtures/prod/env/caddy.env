# HARNESS FIXTURE — stands in for /opt/leviosa/env/caddy.env, the Infisical
# Agent's rendering of prod/caddy (the Cloudflare token) and staging/caddy
# (staging's basic auth). Not real values.
#
# The harness runs Caddy with its internal CA (LEVIOSA_CADDY_TLS=internal, from
# its compose override), so the token is never used; it only has the shape of
# a Cloudflare token, which `caddy validate` of the production variant checks.
CLOUDFLARE_API_TOKEN=harness-fixture-not-a-real-cloudflare-tk
STAGING_BASIC_AUTH_USER=harness
# `caddy hash-password` of the harness's fixed test password (run-harness.sh).
# Single-quoted, as the Agent must render it: Compose expands `$` in unquoted
# env-file values, which would mangle the bcrypt hash.
STAGING_BASIC_AUTH_HASH='$2a$14$1R6.dGApFitAZrS3yIE2N.gDkck7p.MJR7ia4r0uvWzAZ3I5AAdh.'
