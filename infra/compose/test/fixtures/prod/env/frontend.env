# HARNESS FIXTURE — fake values standing in for the Infisical Agent's
# rendering of /opt/leviosa/env/frontend.env: only what the SvelteKit server
# reads. Never a database, AWS, encx, Stripe, Twilio, SMTP or admin value,
# and never ORIGIN (adapter-node derives the origin per host from the two
# headers below, so every hostname behind Caddy works).
NODE_ENV=production
PORT=3000
API_URL=http://backend:3500
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
SESSION_COOKIE_NAME=leviosa_session
CLIENT_IP_HEADER=x-client-ip
# Production first comes up in COMING_SOON mode; /healthz is exempt.
COMING_SOON=true
USE_MOCK_DATA=false
