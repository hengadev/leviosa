# HARNESS FIXTURE — fake, non-secret values standing in for the Infisical
# Agent's rendering of /opt/leviosa/env/backend.env. Loaded by the backend
# and by the migrate and admin one-offs. Never holds ADMIN_* values.
ENVIRONMENT=production
SERVER_PORT=3500
LOG_FORMAT=json

# /db (composite, assembled by the Agent template)
DATABASE_URL=postgres://leviosa:HarnessFixturePg1@postgres:5432/leviosa?sslmode=disable

# /redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=HarnessFixtureRedis1
REDIS_DB=0

# /rabbitmq (composite, with production's vhost)
RABBITMQ_URL=amqp://leviosa:HarnessFixtureMq1@rabbitmq:5672/leviosa

# /encx — the KEK is a LocalStack KMS key the harness creates behind this alias
ENCX_KMS_KEY_ALIAS=alias/leviosa-harness
ENCX_PEPPER=bGV2aW9zYS1oYXJuZXNzLWZpeHR1cmUtcGVwcGVyISE=

# /aws — AWS_ENDPOINT_URL and S3_ENDPOINT exist only in the harness (LocalStack
# on the harness network); the real file never sets them.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
S3_ENDPOINT=http://localstack:4566
S3_REGION=eu-central-1
S3_BUCKET_NAME=leviosa-harness-media
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# /app
SESSION_SECRET=harness-fixture-session-secret-not-real
BOOKING_TOKEN_SECRET=harness-fixture-booking-token-secret-not-real
FRONTEND_ORIGIN=https://harness.leviosa.test

# /stripe, /twilio, /smtp — integrations off in the harness
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_REGION=
TWILIO_EDGE=
TWILIO_SENDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
