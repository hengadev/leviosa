# HARNESS FIXTURE — a minimal stand-in for the real Caddyfile (issue 020):
# plain HTTP on :80; the staging host to staging's frontend, everything else
# to production's frontend. Enough to prove the compose file's Caddy service
# starts on the shared network and reaches each stack's frontend by its
# service name (staging's prefixed one included).
{
	auto_https off
	admin off
}

http://staging.harness.leviosa.test {
	reverse_proxy staging_frontend:3000
}

:80 {
	reverse_proxy frontend:3000
}
