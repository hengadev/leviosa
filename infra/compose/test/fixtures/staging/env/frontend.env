# HARNESS FIXTURE — fake values standing in for the Infisical Agent's
# rendering of /opt/leviosa-staging/env/frontend.env: only what the SvelteKit
# server reads, with API_URL on staging's prefixed backend service. Never a
# database, AWS, encx, Stripe, Twilio, SMTP or admin value, never ORIGIN.
NODE_ENV=production
PORT=3000
API_URL=http://staging_backend:3500
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
SESSION_COOKIE_NAME=leviosa_session
CLIENT_IP_HEADER=x-client-ip
# Staging is behind basic auth (issue 020), not COMING_SOON.
COMING_SOON=false
USE_MOCK_DATA=false
