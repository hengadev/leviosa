# HARNESS FIXTURE — fake, non-secret values standing in for the Infisical
# Agent's rendering of /opt/leviosa-staging/env/backend.env (Infisical
# `staging`). Loaded by staging_backend and the staging_migrate and
# staging_admin one-offs. Never holds ADMIN_* values, and never a production
# credential: the harness checks that no value here contains one.
ENVIRONMENT=staging
SERVER_PORT=3500
LOG_FORMAT=json

# /db — production's Postgres, staging's own role and database (created by
# fixtures/create-staging-services.sh, by Ansible on the server)
DATABASE_URL=postgres://leviosa_staging:HarnessFixtureStagingPg2@postgres:5432/leviosa_staging?sslmode=disable

# /redis — staging's own Redis
REDIS_ADDR=staging_redis:6379
REDIS_PASSWORD=HarnessFixtureStagingRedis2
REDIS_DB=0

# /rabbitmq — production's RabbitMQ, staging's own vhost and user
RABBITMQ_URL=amqp://leviosa_staging:HarnessFixtureStagingMq2@rabbitmq:5672/leviosa_staging

# /encx — staging's own KEK (another LocalStack KMS key) and pepper
ENCX_KMS_KEY_ALIAS=alias/leviosa-harness-staging
ENCX_PEPPER=c3RhZ2luZy1oYXJuZXNzLWZpeHR1cmUtcGVwcGVyISE=

# /aws — AWS_ENDPOINT_URL and S3_ENDPOINT exist only in the harness
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
S3_ENDPOINT=http://localstack:4566
S3_REGION=eu-central-1
S3_BUCKET_NAME=leviosa-harness-staging-media
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# /app
SESSION_SECRET=harness-fixture-staging-session-secret-not-real
BOOKING_TOKEN_SECRET=harness-fixture-staging-booking-token-secret-not-real
FRONTEND_ORIGIN=https://staging.harness.leviosa.test

# /stripe, /twilio, /smtp — integrations off in the harness
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_REGION=
TWILIO_EDGE=
TWILIO_SENDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
