# Terraform files
.terraform/
*.tfstate
*.tfstate.*
# Only the committed, secret-free terraform.tfvars is allowed (the root
# .gitignore ignores it everywhere else). Secrets come from Infisical
# `leviosa-infra` through tf.sh, never from a tfvars file.
*.tfvars
!terraform.tfvars
.terraform-backup/
terraform.tfbackup
crash.log
crash.*.log
terraform-graph.png
