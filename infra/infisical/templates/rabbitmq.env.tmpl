{{- /*
	rabbitmq.env - production's RabbitMQ container (shared with staging,
	which gets its own vhost and user from Ansible, issue 026): the image's
	RABBITMQ_DEFAULT_* variables, mapped from production's /rabbitmq atoms,
	one listSecrets call. Applied when the data directory is first
	initialised, so the Agent only rewrites this file (no command): a
	password rotation is a manual `rabbitmqctl change_password`.
	RABBITMQ_HOST and RABBITMQ_PORT stay out (they are in RABBITMQ_URL).
*/ -}}
# leviosa rabbitmq.env - rendered from Infisical environment __LEVIOSA_ENV__
# by the Infisical Agent. Do not edit: change the value in Infisical.
{{- $user := "" -}}
{{- $password := "" -}}
{{- $vhost := "" -}}
{{- range listSecrets "__LEVIOSA_PROJECT_ID__" "__LEVIOSA_ENV__" "/rabbitmq" -}}
{{- if eq .Key "RABBITMQ_USER" }}{{ $user = .Value }}{{ end -}}
{{- if eq .Key "RABBITMQ_PASSWORD" }}{{ $password = .Value }}{{ end -}}
{{- if eq .Key "RABBITMQ_VHOST" }}{{ $vhost = .Value }}{{ end -}}
{{- end }}
RABBITMQ_DEFAULT_USER='{{ $user }}'
RABBITMQ_DEFAULT_PASS='{{ $password }}'
RABBITMQ_DEFAULT_VHOST='{{ $vhost }}'
