{{- /*
	redis.env - the Redis container of each stack: its password only (the
	compose command writes it into an in-container config file). From the
	stack's own /redis folder, one listSecrets call; REDIS_HOST and
	REDIS_PORT describe how clients reach Redis and stay out.
*/ -}}
# leviosa redis.env - rendered from Infisical environment __LEVIOSA_ENV__
# by the Infisical Agent. Do not edit: change the value in Infisical.
{{- $password := "" -}}
{{- range listSecrets "__LEVIOSA_PROJECT_ID__" "__LEVIOSA_ENV__" "/redis" -}}
{{- if eq .Key "REDIS_PASSWORD" }}{{ $password = .Value }}{{ end -}}
{{- end }}
REDIS_PASSWORD='{{ $password }}'
