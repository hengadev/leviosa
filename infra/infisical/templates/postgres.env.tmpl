{{- /*
	postgres.env - production's Postgres container (shared with staging,
	which gets its own role and database from Ansible, issue 026): the
	official image's three variables, from production's /db atoms, one
	listSecrets call. Applied at the first initdb only, so the Agent only
	rewrites this file (no command): a password rotation is a manual
	ALTER ROLE. POSTGRES_HOST and POSTGRES_PORT stay out (they are how
	clients reach the server, in DATABASE_URL).
*/ -}}
# leviosa postgres.env - rendered from Infisical environment __LEVIOSA_ENV__
# by the Infisical Agent. Do not edit: change the value in Infisical.
{{- $user := "" -}}
{{- $password := "" -}}
{{- $db := "" -}}
{{- range listSecrets "__LEVIOSA_PROJECT_ID__" "__LEVIOSA_ENV__" "/db" -}}
{{- if eq .Key "POSTGRES_USER" }}{{ $user = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_PASSWORD" }}{{ $password = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_DB" }}{{ $db = .Value }}{{ end -}}
{{- end }}
POSTGRES_USER='{{ $user }}'
POSTGRES_PASSWORD='{{ $password }}'
POSTGRES_DB='{{ $db }}'
