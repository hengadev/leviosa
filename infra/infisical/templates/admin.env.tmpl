{{- /*
	admin.env - the /admin folder (the first superadmin, bootstrap-admin).
	Loaded ONLY by each stack's admin one-off, never by a long-running
	container; `make env` appends the dev rendering to
	backend/development.env so local development bootstraps the same way.
	Whole folder, one listSecrets call; values single-quoted (an admin
	password may hold $ or #).
*/ -}}
# leviosa admin.env - rendered from Infisical environment __LEVIOSA_ENV__
# by the Infisical Agent (server) or `make env` (local). Do not edit: change
# the value in Infisical.
{{- range listSecrets "__LEVIOSA_PROJECT_ID__" "__LEVIOSA_ENV__" "/admin" }}
{{ .Key }}='{{ .Value }}'
{{- end }}
