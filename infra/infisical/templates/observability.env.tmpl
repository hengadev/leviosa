{{- /*
	observability.env - production's Alloy monitoring agent
	(infra/ansible/roles/observability): prod's /observability, rendered whole
	(INGEST_URL, INGEST_TOKEN), names unchanged. The agent pushes metrics to
	the homelab with them. Ignores the environment slug (always prod);
	rendered for the prod stack only. The Agent recreates alloy when it
	changes.
*/ -}}
# leviosa observability.env - rendered from Infisical prod/observability by
# the Infisical Agent. Do not edit: change the value in Infisical.
{{- range listSecrets "__LEVIOSA_PROJECT_ID__" "prod" "/observability" }}
{{ .Key }}='{{ .Value }}'
{{- end }}
