{{- /*
	backend.env - everything the Go backend receives: the long-running
	backend and its migrate and admin one-offs, in each stack; with
	admin.env, backend/development.env for `make env`.

	Rules (README.md next to this directory):
	- ONE recursive listSecrets call over the whole environment, filtered by
	  folder (.SecretPath): the Agent change-detects a template through the
	  ETag of its last secret call only, so one call makes a change in ANY
	  folder below reach the backend within one poll.
	- Printed whole: /app, /encx, /aws, /stripe, /smtp, /twilio - a key added
	  there reaches the backend with no template change.
	- Assembled from atoms, never printed raw: DATABASE_URL (/db),
	  RABBITMQ_URL with its vhost (/rabbitmq), REDIS_ADDR (/redis host and
	  port; the rest of /redis is printed whole).
	- Never printed: /admin (admin.env only), /caddy, /backup, /host.
	- S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_REGION repeat /aws's AWS_*
	  atoms (Terraform writes them once; the S3 client reads S3_*, KMS AWS_*).
	- ENVIRONMENT, SERVER_PORT, LOG_FORMAT and REDIS_DB are set here, from
	  the environment slug and the stacks' wiring: never put them in
	  Infisical (they would be duplicated). ENVIRONMENT is always explicit:
	  bootstrap-admin falls back to development defaults when it is unset.
	- Values are single-quoted: Compose expands $ and strips " #..." in
	  unquoted values. A value may not contain a single quote or a newline.
	- Go built-ins only (no sprig), so any Agent version renders it.
*/ -}}
# leviosa backend.env - rendered from Infisical environment __LEVIOSA_ENV__
# by the Infisical Agent (server) or `make env` (local). Do not edit: change
# the value in Infisical.
{{- $environment := "" -}}
{{- $logFormat := "" -}}
{{- if eq "__LEVIOSA_ENV__" "prod" -}}
{{- $environment = "production" -}}{{- $logFormat = "json" -}}
{{- else if eq "__LEVIOSA_ENV__" "staging" -}}
{{- $environment = "staging" -}}{{- $logFormat = "json" -}}
{{- else if eq "__LEVIOSA_ENV__" "dev" -}}
{{- $environment = "development" -}}{{- $logFormat = "text" -}}
{{- end }}
ENVIRONMENT='{{ $environment }}'
SERVER_PORT='3500'
LOG_FORMAT='{{ $logFormat }}'
REDIS_DB='0'
{{- $pgUser := "" -}}
{{- $pgPassword := "" -}}
{{- $pgHost := "" -}}
{{- $pgPort := "" -}}
{{- $pgDb := "" -}}
{{- $mqUser := "" -}}
{{- $mqPassword := "" -}}
{{- $mqHost := "" -}}
{{- $mqPort := "" -}}
{{- $mqVhost := "" -}}
{{- $redisHost := "" -}}
{{- $redisPort := "" -}}
{{- $awsKeyID := "" -}}
{{- $awsSecret := "" -}}
{{- $awsRegion := "" -}}
{{- range listSecrets "__LEVIOSA_PROJECT_ID__" "__LEVIOSA_ENV__" "/" `{"recursive": true}` -}}
{{- if or (eq .SecretPath "/app") (eq .SecretPath "/encx") (eq .SecretPath "/aws") (eq .SecretPath "/stripe") (eq .SecretPath "/smtp") (eq .SecretPath "/twilio") }}
{{ .Key }}='{{ .Value }}'
{{- end -}}
{{- if eq .SecretPath "/aws" -}}
{{- if eq .Key "AWS_ACCESS_KEY_ID" }}{{ $awsKeyID = .Value }}{{ end -}}
{{- if eq .Key "AWS_SECRET_ACCESS_KEY" }}{{ $awsSecret = .Value }}{{ end -}}
{{- if eq .Key "AWS_REGION" }}{{ $awsRegion = .Value }}{{ end -}}
{{- else if eq .SecretPath "/redis" -}}
{{- if eq .Key "REDIS_HOST" }}{{ $redisHost = .Value }}
{{- else if eq .Key "REDIS_PORT" }}{{ $redisPort = .Value }}
{{- else }}
{{ .Key }}='{{ .Value }}'
{{- end -}}
{{- else if eq .SecretPath "/db" -}}
{{- if eq .Key "POSTGRES_USER" }}{{ $pgUser = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_PASSWORD" }}{{ $pgPassword = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_HOST" }}{{ $pgHost = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_PORT" }}{{ $pgPort = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_DB" }}{{ $pgDb = .Value }}{{ end -}}
{{- else if eq .SecretPath "/rabbitmq" -}}
{{- if eq .Key "RABBITMQ_USER" }}{{ $mqUser = .Value }}{{ end -}}
{{- if eq .Key "RABBITMQ_PASSWORD" }}{{ $mqPassword = .Value }}{{ end -}}
{{- if eq .Key "RABBITMQ_HOST" }}{{ $mqHost = .Value }}{{ end -}}
{{- if eq .Key "RABBITMQ_PORT" }}{{ $mqPort = .Value }}{{ end -}}
{{- if eq .Key "RABBITMQ_VHOST" }}{{ $mqVhost = .Value }}{{ end -}}
{{- end -}}
{{- end }}
{{- /* URL atoms are urlquery-encoded. Keep the passwords letters and digits
     only: urlquery writes a space as "+", which is wrong inside userinfo.
     The vhost is always explicit; "/" (the default vhost) becomes %2F. */}}
DATABASE_URL='postgres://{{ urlquery $pgUser }}:{{ urlquery $pgPassword }}@{{ $pgHost }}:{{ $pgPort }}/{{ $pgDb }}?sslmode=disable'
RABBITMQ_URL='amqp://{{ urlquery $mqUser }}:{{ urlquery $mqPassword }}@{{ $mqHost }}:{{ $mqPort }}/{{ urlquery $mqVhost }}'
REDIS_ADDR='{{ $redisHost }}:{{ $redisPort }}'
S3_ACCESS_KEY_ID='{{ $awsKeyID }}'
S3_SECRET_ACCESS_KEY='{{ $awsSecret }}'
S3_REGION='{{ $awsRegion }}'
