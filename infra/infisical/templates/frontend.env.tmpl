{{- /*
	frontend.env - the SvelteKit server's (adapter-node) environment, in each
	stack; frontend/.env for `make env`.

	The frontend must never see a backend secret, so this is an ALLOWLIST,
	not a whole folder: /app also holds backend-only secrets
	(SESSION_SECRET, BOOKING_TOKEN_SECRET), and nothing from /aws, /encx,
	/stripe, /twilio, /smtp, /db, /admin, /redis, /rabbitmq, /caddy, /backup
	or /host is ever read. A new frontend key needs a line here (and in
	envcheck.FrontendKeys) - a deliberate review point.

	- ONE listSecrets call, on /app only (the Agent change-detects a template
	  through the ETag of its last secret call).
	- From /app: COMING_SOON, SESSION_COOKIE_NAME, CLIENT_IP_HEADER and the
	  optional PUBLIC_PLAUSIBLE_DOMAIN / PUBLIC_PLAUSIBLE_SRC.
	- Set here, from the environment slug and the stacks' wiring: NODE_ENV,
	  PORT, API_URL (the stack's backend service), PROTOCOL_HEADER and
	  HOST_HEADER (Caddy serves several hostnames: adapter-node derives the
	  origin per request, so ORIGIN is never set), and USE_MOCK_DATA=false
	  (mock mode trusts a client cookie for the role: never in a rendered
	  file).
	- Values are single-quoted (Compose expands $ in unquoted values).
	- Go built-ins only (no sprig).
*/ -}}
# leviosa frontend.env - rendered from Infisical environment __LEVIOSA_ENV__
# by the Infisical Agent (server) or `make env` (local). Do not edit: change
# the value in Infisical.
{{- $nodeEnv := "" -}}
{{- $apiURL := "" -}}
{{- if eq "__LEVIOSA_ENV__" "prod" -}}
{{- $nodeEnv = "production" -}}{{- $apiURL = "http://backend:3500" -}}
{{- else if eq "__LEVIOSA_ENV__" "staging" -}}
{{- $nodeEnv = "production" -}}{{- $apiURL = "http://staging_backend:3500" -}}
{{- else if eq "__LEVIOSA_ENV__" "dev" -}}
{{- $nodeEnv = "development" -}}{{- $apiURL = "http://localhost:3500" -}}
{{- end }}
NODE_ENV='{{ $nodeEnv }}'
PORT='3000'
API_URL='{{ $apiURL }}'
PROTOCOL_HEADER='x-forwarded-proto'
HOST_HEADER='host'
USE_MOCK_DATA='false'
{{- range listSecrets "__LEVIOSA_PROJECT_ID__" "__LEVIOSA_ENV__" "/app" -}}
{{- if or (eq .Key "COMING_SOON") (eq .Key "SESSION_COOKIE_NAME") (eq .Key "CLIENT_IP_HEADER") (eq .Key "PUBLIC_PLAUSIBLE_DOMAIN") (eq .Key "PUBLIC_PLAUSIBLE_SRC") }}
{{ .Key }}='{{ .Value }}'
{{- end -}}
{{- end }}
