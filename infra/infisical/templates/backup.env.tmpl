{{- /*
	backup.env - production's backup job (issue 028): every key of /backup
	(written by Terraform, prod only) plus the two /db atoms pg_dump needs
	(user and database; the dump runs through `docker exec`, so no password,
	host or port).

	ONE recursive listSecrets call, filtered by folder (.SecretPath), so a
	change in /backup or /db is change-detected. The Agent rewrites this file
	with no command; the job reads it fresh on each run. Values
	single-quoted (systemd's EnvironmentFile and sh read them literally).
*/ -}}
# leviosa backup.env - rendered from Infisical environment __LEVIOSA_ENV__
# by the Infisical Agent. Do not edit: change the value in Infisical.
{{- $pgUser := "" -}}
{{- $pgDb := "" -}}
{{- range listSecrets "__LEVIOSA_PROJECT_ID__" "__LEVIOSA_ENV__" "/" `{"recursive": true}` -}}
{{- if eq .SecretPath "/backup" }}
{{ .Key }}='{{ .Value }}'
{{- else if eq .SecretPath "/db" -}}
{{- if eq .Key "POSTGRES_USER" }}{{ $pgUser = .Value }}{{ end -}}
{{- if eq .Key "POSTGRES_DB" }}{{ $pgDb = .Value }}{{ end -}}
{{- end -}}
{{- end }}
POSTGRES_USER='{{ $pgUser }}'
POSTGRES_DB='{{ $pgDb }}'
